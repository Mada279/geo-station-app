// ============================================================
//   GEO STATION PLATFORM — PRODUCTION DATABASE SCHEMA (POSTGRESQL / SUPABASE)
//   Architectural Specification & ERD in DBML format
//   Target: Supabase (PostgreSQL 15+)
// ============================================================

Project geo_station {
  database_type: 'PostgreSQL'
  Note: '''
    # منصة جيو ستيشن (Geo Station Platform)
    سوق رقمي متكامل لمعدات المساحة، الخدمات الهندسية، المعايرة، الدورات التدريبية، والتوظيف.
    مصمم ليعمل بكفاءة على Supabase مع الالتزام بقواعد النزاهة المرجعية (Foreign Keys)،
    تتبع الـ SLA، نموذج Pay-Per-Lead، ومراجعات موثقة 100% مرتبطة بطلبات حقيقية.
  '''
}

// ------------------------------------------------------------
// ENUMS (القوائم المحددة)
// ------------------------------------------------------------

Enum user_role {
  super_admin    [note: 'مدير عام المنصة — كامل الصلاحيات']
  admin          [note: 'مسؤول تشغيل']
  provider       [note: 'مزوّد خدمة / شركة / مكتب / مورد']
  client         [note: 'عميل (شركة مقاولات، مطور عقاري، جهة حكومية، فرد)']
  data_entry     [note: 'مُدخل بيانات وتدقيق فني']
}

Enum account_status {
  active
  suspended
  pending_verification
}

Enum provider_type {
  offices              [note: 'مكتب مساحة']
  companies            [note: 'شركة مساحة وجيوماتكس']
  suppliers            [note: 'مورد وموزع أجهزة مساحة']
  calibration_center   [note: 'مركز صيانة ومعايرة معتمد']
  training_center      [note: 'مركز تدريب وأكاديمية']
  surveyors            [note: 'مسّاح محترف فردي']
}

Enum verification_level {
  basic               [note: 'ملف موثّق أساسي (هوية / سجل)']
  verified_activity   [note: 'نشاط موثّق ميدانياً']
  verified_equipment  [note: 'معدات مفحوصة وموثّقة']
}

Enum saas_tier {
  free
  silver
  gold
  platinum
}

Enum subscription_status {
  trial
  active
  past_due
  cancelled
}

Enum equipment_category {
  total_station        [note: 'محطات الرصد المتكاملة']
  gnss_rtk             [note: 'أجهزة استقبال الأقمار الصناعية']
  laser_scanner        [note: 'الماسح الليزري ثلاثي الأبعاد']
  drone                [note: 'طائرات المسح الجوي بدون طيار']
  auto_level           [note: 'أجهزة الميزان الميكانيكية والإلكترونية']
  accessories_parts    [note: 'حوامل، عواكس، كابلات، قطع غيار']
  other
}

Enum equipment_condition {
  brand_new            [note: 'جديد']
  used_mint            [note: 'مستعمل — ممتاز']
  used_good            [note: 'مستعمل — جيد']
  needs_maintenance    [note: 'يحتاج صيانة']
}

Enum listing_mode {
  sale                 [note: 'بيع فقط']
  rent                 [note: 'تأجير فقط']
  both                 [note: 'بيع وتأجير']
}

Enum calibration_status {
  valid                [note: 'شهادة معايرة سارية']
  expired              [note: 'منتهية — يلزم معايرة']
  factory_certified    [note: 'شهادة مصنع (أجهزة جديدة)']
  none                 [note: 'غير مدرجة / بدون معايرة']
  not_applicable       [note: 'لا ينطبق (مثل الحوامل والملحقات)']
}

Enum availability_status {
  available            [note: 'متاح فوراً']
  rented               [note: 'مؤجر حالياً']
  reserved             [note: 'محجوز']
  maintenance          [note: 'في الصيانة']
}

Enum course_level {
  beginner
  intermediate
  advanced
}

Enum job_type {
  full_time            [note: 'دوام كامل']
  part_time            [note: 'دوام جزئي']
  project_contract     [note: 'عقد مشروع']
  per_job              [note: 'باليومية أو بالطلعة']
}

Enum job_status {
  draft
  published
  closed
  archived
}

Enum application_status {
  submitted
  reviewing
  shortlisted
  rejected
  hired
}

Enum lead_source {
  provider_profile     [note: 'من صفحة ملف المزوّد']
  equipment_page       [note: 'من صفحة إعلان جهاز معين']
  service_page         [note: 'من صفحة خدمة مساحية']
  course_page          [note: 'من صفحة دورة تدريبية']
  search_results       [note: 'من نتائج البحث العامة']
  interactive_map      [note: 'من الخريطة التفاعلية']
  rfq_need_request     [note: 'طلب احتياج عام تم توجيهه للمزود']
}

Enum lead_status {
  new                  [note: 'طلب جديد لم يُفتح بعد']
  opened               [note: 'تم فتح الطلب وقراءة البيانات']
  contacted            [note: 'تم التواصل مع العميل']
  negotiating          [note: 'قيد التفاوض']
  won_closed           [note: 'تم الاتفاق بنجاح']
  lost_closed          [note: 'لم يتم الاتفاق']
  duplicate_spam       [note: 'طلب مكرر أو غير جاد (مسترجع)']
}

Enum wallet_tx_type {
  deposit              [note: 'شحن رصيد المحفظة']
  lead_charge          [note: 'خصم تكلفة فتح Lead']
  subscription_fee     [note: 'خصم اشتراك باقة SaaS']
  refund               [note: 'استرداد قيمة طلب غير صالح (Spam Refund)']
  admin_adjustment     [note: 'تسوية يدوية من الإدارة']
}

Enum review_status {
  pending_moderation   [note: 'قيد مراجعة الإدارة']
  published            [note: 'منشور علناً']
  rejected             [note: 'مرفوض لمخالفة المعايير']
  disputed             [note: 'محل نزاع من المزود']
}

Enum audit_action {
  INSERT
  UPDATE
  DELETE
  STATUS_CHANGE
  WALLET_ADJUST
  VERIFICATION_UPDATE
  LOGIN_AUDIT
}

// ------------------------------------------------------------
// TABLES (الجداول الأساسية)
// ------------------------------------------------------------

Table users {
  id uuid [pk, note: 'يتطابق مع auth.users.id في Supabase']
  email varchar(255) [unique, not null]
  phone varchar(30) [unique]
  full_name varchar(150) [not null]
  role user_role [not null, default: 'client']
  status account_status [not null, default: 'active']
  avatar_url text
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    email
    phone
    role
    status
  }
  Note: 'جدول المستخدمين المركزي المرتبط بنظام الهوية في Supabase Auth'
}

Table clients {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [unique, not null, ref: - users.id, note: 'علاقة 1-إلى-1 مع جدول المستخدمين']
  client_type varchar(50) [not null, note: 'شركة تطوير عقاري، مقاولات، جهة حكومية، فرد']
  company_name varchar(200)
  contact_person varchar(150)
  governorate varchar(50) [not null]
  city varchar(100)
  total_leads_count int [default: 0]
  closed_deals_count int [default: 0]
  internal_notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    governorate
    client_type
  }
  Note: 'الملفات التعريفية الخاصة بالعملاء وطالبي الخدمات والمعدات'
}

Table providers {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [unique, not null, ref: - users.id, note: 'علاقة 1-إلى-1 مع المستخدم المالك للحساب']
  commercial_name varchar(200) [not null]
  slug varchar(200) [unique, not null]
  provider_type provider_type [not null]
  governorate varchar(50) [not null]
  city varchar(100) [not null]
  address_details text
  latitude decimal(10, 8) [note: 'خط العرض للخرائط والبحث الجغرافي']
  longitude decimal(11, 8) [note: 'خط الطول للخرائط']
  verification_level verification_level [not null, default: 'basic']
  saas_tier saas_tier [not null, default: 'free']
  saas_status subscription_status [not null, default: 'trial']
  saas_expires_at timestamptz
  wallet_balance decimal(12, 2) [not null, default: 0.00, note: 'رصيد المحفظة لخصم طلبات التواصل Pay-per-lead']
  avg_rating decimal(3, 2) [not null, default: 0.00]
  reviews_count int [not null, default: 0]
  response_time_avg_hours decimal(5, 2) [note: 'متوسط سرعة الاستجابة بالساعات المحسوبة آلياً']
  year_established int
  staff_count_range varchar(50)
  logo_url text
  cover_url text
  about_text text
  is_featured boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    slug [unique]
    provider_type
    governorate
    city
    verification_level
    is_featured
    (latitude, longitude) [name: 'idx_providers_coordinates']
  }
  Note: 'ملف المزوّد (مكتب مساحة، شركة، مركز صيانة، مورد، أكاديمية)'
}

Table wallet_transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  provider_id uuid [not null, ref: > providers.id]
  lead_id uuid [ref: > leads.id, note: 'الطلب المرتبط إذا كانت العملية خصم ليد أو استرجاع']
  amount decimal(12, 2) [not null, note: 'موجب للإيداع، سالب للخصم']
  tx_type wallet_tx_type [not null]
  balance_after decimal(12, 2) [not null]
  reference_no varchar(100) [unique, note: 'رقم العملية من بوابة الدفع مثل فوري، كاش، فيزا']
  notes text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    provider_id
    tx_type
    created_at
  }
  Note: 'سجل حركات المحفظة المالية للمزود بدقة محاسبية'
}

Table equipment {
  id uuid [pk, default: `gen_random_uuid()`]
  provider_id uuid [not null, ref: > providers.id]
  title varchar(250) [not null]
  slug varchar(250) [unique, not null]
  category equipment_category [not null]
  brand varchar(100) [not null]
  model varchar(100) [not null]
  condition equipment_condition [not null, default: 'used_mint']
  modes listing_mode [not null, default: 'both']
  price_sale decimal(12, 2)
  price_rent_daily decimal(12, 2)
  price_rent_monthly decimal(12, 2)
  currency varchar(10) [not null, default: 'EGP']
  
  // شروط المعايرة الصارمة (Calibration Tracking)
  calibration_status calibration_status [not null, default: 'none']
  calibration_expiry_date date [note: 'تاريخ انتهاء شهادة المعايرة الدورية']
  calibration_cert_url text [note: 'رابط صورة أو PDF شهادة المعايرة']
  calibration_center_name varchar(200) [note: 'اسم جهة أو مركز المعايرة المعتمد']

  availability_status availability_status [not null, default: 'available']
  manufacturing_year int
  description text
  specs jsonb [note: 'مواصفات مرنة: دقة الزاوية، المدى، الكنترولر، عدد القنوات']
  images jsonb [note: 'مصفوفة روابط صور الجهاز']
  views_count int [not null, default: 0]
  is_featured boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    slug [unique]
    provider_id
    category
    brand
    calibration_status
    availability_status
    price_sale
    price_rent_daily
  }
  Note: 'سوق أجهزة المساحة (بيع وتأجير ومعايرة)'
}

Table services {
  id uuid [pk, default: `gen_random_uuid()`]
  provider_id uuid [not null, ref: > providers.id]
  title varchar(200) [not null]
  slug varchar(200) [not null]
  category_name varchar(100) [not null, note: 'رفع مساحي، مسح ليزري 3D، درون، GIS، As-Built']
  description text [not null]
  base_price decimal(12, 2)
  pricing_unit varchar(50) [note: 'للفدان، للمشروع، بالنقطة، بالكم']
  deliverables jsonb [note: 'مخرجات الخدمة: CAD, GIS Shapefiles, Point Cloud E57']
  coverage_governorates jsonb [note: 'قائمة المحافظات المغطاة بهذه الخدمة']
  icon_key varchar(50)
  image_url text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    provider_id
    category_name
    is_active
  }
  Note: 'الخدمات الهندسية والمساحية التي يقدمها المزود'
}

Table courses {
  id uuid [pk, default: `gen_random_uuid()`]
  provider_id uuid [not null, ref: > providers.id]
  title varchar(200) [not null]
  slug varchar(200) [not null]
  level course_level [not null, default: 'beginner']
  duration_hours int [not null]
  price decimal(10, 2) [not null]
  currency varchar(10) [not null, default: 'EGP']
  delivery_type varchar(50) [default: 'ميداني وحضوري', note: 'حضوري، أونلاين، هجين']
  location_address text
  description text [not null]
  topics jsonb [note: 'مفردات الدورة وتطبيقاتها الميدانية']
  certificate_included boolean [default: true]
  image_url text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    provider_id
    level
    is_active
  }
  Note: 'الدورات التدريبية الميدانية والبرمجية التابعة لأكاديميات ومراكز المساحة'
}

Table jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  provider_id uuid [not null, ref: > providers.id]
  title varchar(200) [not null]
  slug varchar(200) [not null]
  job_type job_type [not null, default: 'full_time']
  experience_range varchar(50) [note: 'مثال: 3-5 سنوات']
  salary_display varchar(100) [note: 'مثال: يُحدد بعد المقابلة، أو 15000-20000 ج.م']
  min_salary decimal(10, 2)
  max_salary decimal(10, 2)
  governorate varchar(50) [not null]
  description text [not null]
  requirements jsonb [note: 'مصفوفة الشروط الفنية والمؤهلات']
  status job_status [not null, default: 'published']
  applications_count int [not null, default: 0]
  expires_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    provider_id
    governorate
    job_type
    status
  }
  Note: 'بوابة وظائف المساحة والجيوماتكس'
}

Table job_applications {
  id uuid [pk, default: `gen_random_uuid()`]
  job_id uuid [not null, ref: > jobs.id]
  applicant_user_id uuid [ref: > users.id, note: 'اختياري في حال كان المتقدم مسجل كمسّاح']
  full_name varchar(150) [not null]
  phone varchar(30) [not null]
  email varchar(255) [not null]
  years_of_experience decimal(4, 1)
  resume_url text [not null]
  cover_note text
  status application_status [not null, default: 'submitted']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    job_id
    applicant_user_id
    status
  }
  Note: 'طلبات التقدم للوظائف المعروضة'
}

Table leads {
  id uuid [pk, default: `gen_random_uuid()`]
  lead_number serial [unique, note: 'رقم تسلسلي مقروء للمرجع مثل #1042']
  client_id uuid [ref: > clients.id, note: 'معرّف العميل إن كان مسجلاً بالمنصة']
  provider_id uuid [not null, ref: > providers.id]
  
  // الارتباط بالأصل المطلوب
  equipment_id uuid [ref: > equipment.id]
  service_id uuid [ref: > services.id]
  course_id uuid [ref: > courses.id]
  
  subject varchar(250) [not null]
  message text
  client_name varchar(150) [not null]
  client_phone varchar(30) [not null]
  client_email varchar(255)
  governorate varchar(50) [not null]
  source lead_source [not null, default: 'provider_profile']
  status lead_status [not null, default: 'new']
  
  // نموذج الأعمال Pay-per-lead والرسوم
  fee_amount decimal(10, 2) [not null, default: 0.00, note: 'المبلغ المخصوم من محفظة المزود']
  is_charged boolean [not null, default: false]
  
  // مؤشرات سرعة الاستجابة والـ SLA
  opened_at timestamptz [note: 'لحظة فتح المزود للطلب وعرض بيانات الاتصال']
  first_responded_at timestamptz [note: 'لحظة تسجيل أول تواصل فعلي']
  response_time_seconds int [note: 'الزمن المستغرق من إنشاء الطلب حتى الرد بالثواني']
  sla_target_hours int [default: 24, note: 'الحد الأقصى المسموح به للرد']
  sla_breached boolean [not null, default: false, note: 'هل تم كسر الـ SLA المحدد؟']
  
  resolution_notes text [note: 'ملاحظات إغلاق الطلب، أسباب الرفض، أو قيمة التعاقد']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    provider_id
    client_id
    status
    source
    governorate
    created_at
    sla_breached
  }
  Note: 'محرك الربط بين العملاء والمزودين — عصب النموذج التجاري للمنصة'
}

Table reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  lead_id uuid [unique, not null, ref: - leads.id, note: 'علاقة 1-إلى-1 صارمة مع الطلب لمنع التقييمات الوهمية']
  provider_id uuid [not null, ref: > providers.id]
  client_id uuid [not null, ref: > clients.id]
  
  rating int [not null, note: 'تقييم شامل من 1 إلى 5']
  criteria_ratings jsonb [note: 'تفصيل المعايير: دقة الأجهزة، الالتزام بالمواعيد، الاحترافية']
  review_text text [not null]
  status review_status [not null, default: 'pending_moderation']
  
  provider_response text [note: 'رد المزود على التقييم']
  provider_responded_at timestamptz
  
  moderation_reason text [note: 'سبب القبول/الرفض في حال التدقيق']
  moderated_by uuid [ref: > users.id]
  
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    provider_id
    client_id
    status
    rating
  }
  Note: 'التقييمات الموثقة — لا يمكن إضافة تقييم إلا بعد إتمام طلب فعلي (Verified Deal)'
}

Table audit_logs {
  id bigserial [pk]
  actor_id uuid [ref: > users.id, note: 'المستخدم الذي نفذ الإجراء (أدمن، مُدخل بيانات، مزود)']
  actor_role varchar(50) [not null]
  action audit_action [not null]
  entity varchar(50) [not null, note: 'اسم الجدول المستهدف']
  entity_id varchar(100) [not null, note: 'معرف السجل المستهدف']
  before_state jsonb [note: 'حالة الكائن قبل التعديل']
  after_state jsonb [note: 'حالة الكائن بعد التعديل']
  ip_address varchar(45) [note: 'عنوان IP للمنفّذ']
  user_agent text
  note text
  created_at timestamptz [not null, default: `now()` - 'جدول غير قابل للتعديل أو الحذف (Append-only)']

  indexes {
    actor_id
    entity
    entity_id
    created_at
  }
  Note: 'سجل التدقيق الأمني الشامل والرقابي غير القابل للتعديل'
}
